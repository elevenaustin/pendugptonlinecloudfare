LEADS_SUPABASE_SERVICE_ROLE_KEY="your_leads_supabase_service_role_key"

# n8n Video Inactivity Comeback Webhook (Production Endpoint)
# Server-only environment variables (Do NOT prefix with VITE_ or expose to client)
N8N_VIDEO_INACTIVITY_WEBHOOK_URL="https://pendugptonline.app.n8n.cloud/webhook/pendugpt-video-inactivity-v2"
N8N_VIDEO_INACTIVITY_WEBHOOK_SECRET="your_n8n_video_inactivity_webhook_secret"
